# ==============================================================================
# NewsHub Environment Variables Example Template
# Copy file này thành `.env` và điền credentials thực tế của bạn
# ==============================================================================

# Supabase PostgreSQL Connection String
ConnectionStrings__DefaultConnection="Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT="Development"

# Supabase Project Configuration
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
