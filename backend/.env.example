# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT="Development"

# ── Database: Supabase PostgreSQL ─────────────────────────────────────────
# Connection string trực tiếp tới Postgres (Port 5432) hoặc qua Transaction Pooler (Port 6543)
ConnectionStrings__DefaultConnection="Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# Supabase Project Metadata
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# ── Security & Authentication: JWT Settings ──────────────────────────────
# Secret key tối thiểu 32 ký tự ngẫu nhiên bảo mật (HMAC-SHA256)
Jwt__SecretKey="YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_HERE"
Jwt__Issuer="NewsHubAPI"
Jwt__Audience="NewsHubClients"
Jwt__AccessTokenExpirationMinutes="15"
Jwt__RefreshTokenExpirationDays="7"

# ── Cloud Storage: Cloudinary (Quản lý toàn bộ Media/Hình ảnh) ─────────────
# Đăng ký tài khoản miễn phí tại https://cloudinary.com
Cloudinary__CloudName="YOUR_CLOUDINARY_CLOUD_NAME"
Cloudinary__ApiKey="YOUR_CLOUDINARY_API_KEY"
Cloudinary__ApiSecret="YOUR_CLOUDINARY_API_SECRET"

# ── Task Queue & Background Jobs: Hangfire ────────────────────────────────
# Hangfire Dashboard URL & Thông tin đăng nhập bảo vệ Dashboard
Hangfire__DashboardPath="/hangfire"
Hangfire__DashboardUsername="admin"
Hangfire__DashboardPassword="StrongHangfirePassword123!"

# ── Distributed Cache: Redis ──────────────────────────────────────────────
# Kết nối Redis (Upstash Redis, Redis Cloud hoặc Local Docker)
Redis__ConnectionString="localhost:6379,abortConnect=false"
Redis__InstanceName="NewsHub:"

# ── Generative AI: Google Gemini API ──────────────────────────────────────
# Lấy API Key miễn phí tại https://aistudio.google.com/
Gemini__ApiKey="YOUR_GEMINI_API_KEY"
Gemini__ModelName="gemini-1.5-flash"
Gemini__EmbeddingModel="text-embedding-004"

# ── CORS Configuration ───────────────────────────────────────────────────
Cors__AllowedOrigins__0="URL_HERE"
Cors__AllowedOrigins__1="URL_HERE"
